<script>
import router from "@system.router"

export default {
  goSearch() {
    router.push({
      uri: "/pages/search"
    })
  },

  goHistory() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
