  </div>
</template>

<script>
import router from "@system.router"

export default {
  goInflectSearch() {
    router.push({
      uri: "/pages/search",
      params: {
        searchMode: "inflect",
        inflectDepth: "0"
      }
    })
  },

  goSearch() {
    router.push({
      uri: "/pages/search"
    })
  },

  goHistory() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
      }
    })
  },

  goAbout() {
    router.push({
      uri: "/pages/about"
    })
  },

  goSponsor() {
    router.push({
      uri: "/pages/sponsor"
    })
  }
}
</script>

