      </list-item>
      <list-item type="filterRow" style="width: {{cardWidth}}px; height: 90px;">
        <div class="record-card" @click="onLetterTap('I')">
          <div class="record-head">
            <text class="record-title">I</text>
          </div>
        </div>
      </list-item>
