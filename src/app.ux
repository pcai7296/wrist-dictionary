<script>
import device from "@system.device"
import buildTarget from "./common/buildTarget"

export default {
  data: {
    screenShape: buildTarget.shape,
    screenWidth: buildTarget.width,
    screenHeight: buildTarget.height,
    screenAspectRatio: 0,
    screenProfile: buildTarget.profile,
    buildTargetId: buildTarget.id
  },

  updateScreenInfo(data) {
    const appData = this.data
    if (data && data.screenShape) {
      appData.screenShape = data.screenShape
    }
    if (data && data.screenWidth) {
      appData.screenWidth = Number(data.screenWidth)
    }
    if (data && data.screenHeight) {
      appData.screenHeight = Number(data.screenHeight)
    }
    if (appData.screenHeight > 0) {
      appData.screenAspectRatio =
        Math.round((appData.screenWidth / appData.screenHeight) * 1000) / 1000
    }
    if (appData.screenShape === "circle") {
      appData.screenProfile = "circle"
    } else if (appData.screenShape === "rect") {
      appData.screenProfile = "rect"
    } else if (appData.screenAspectRatio <= 0.4) {
      appData.screenProfile = "pill-compact"
    } else {
      appData.screenProfile = "pill-standard"
    }
  },

  onCreate() {
    console.log("app created")
    const appData = this.data
    if (appData.screenHeight > 0) {
      appData.screenAspectRatio =
        Math.round((appData.screenWidth / appData.screenHeight) * 1000) / 1000
    }
    console.log(
      "compiled screen target=" +
        appData.buildTargetId +
        " shape=" +
        appData.screenShape +
        " width=" +
        appData.screenWidth +
        " profile=" +
        appData.screenProfile
    )
    device.getInfo({
      success: (data) => {
        this.updateScreenInfo(data)
        console.log(
          "runtime screen detected width=" +
            this.data.screenWidth +
            " height=" +
            this.data.screenHeight +
            " profile=" +
            this.data.screenProfile
        )
      },
      fail: (data, code) => {
        console.log("device.getInfo failed; using compiled target: " + code)
      }
    })
  },

  onDestroy() {
    console.log("app destroyed")
  }
}
</script>
