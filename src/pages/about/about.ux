<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="back-pill" @click="goBack">
      <text class="back-mark">&lt;</text>
    </div>

    <div class="app-card">
      <text class="app-name">腕上词典</text>
      <text class="app-version">1.0</text>
      <div class="mini-icon">
        <div class="mini-left">
          <div class="mini-line short"></div>
          <div class="mini-line"></div>
        </div>
        <div class="mini-right">
          <div class="mini-mark"></div>
          <div class="mini-line right-line"></div>
        </div>
      </div>
    </div>

    <text class="section-title">Developers</text>
    <text class="dev-role">开发</text>
    <text class="dev-name">@睡不着的鸿鹄</text>
    <text class="dev-role">UI设计参考</text>
    <text class="dev-name">@无源流沙</text>

    <text class="license-title">词库来源</text>
    <text class="license-line">skywind3000/ECDICT</text>
    <text class="license-line">MIT License</text>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  private: {
    touchStartX: -1,
    touchStartY: -1
  },

  goBack() {
    router.back()
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const startsInLeftQuarter = this.touchStartX <= 53
    const endsAtRightQuarter = endX >= 159
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

