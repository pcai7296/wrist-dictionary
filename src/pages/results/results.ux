  width: 70px;
  height: 30px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.query-text,
.query-marquee {
  width: 168px;
  height: 36px;
  margin-top: 12px;
  margin-bottom: 6px;
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
  text-align: center;
}

.query-marquee {
  lines: 1;
  text-overflow: clip;
}

.status-text {
  width: 200px;
  height: 20px;
  margin-bottom: 4px;
  color: #7eaef8;
  font-size: 14px;
  text-align: center;
}

.result-list {
  height: 388px;
  margin-bottom: 4px;
}

.next-button {
  height: 56px;
  border-radius: 20px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.next-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.result-item {
  /* width bound inline */
}

.result-card {
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 12px;
  margin-bottom: 10px;
  border-radius: 20px;
  background-color: #242424;
  flex-direction: column;
}

.result-head {
  width: 100%;
  height: 38px;
  flex-direction: row;
  align-items: center;
}

.result-word,
.result-word-marquee {
  flex: 1;
  height: 38px;
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
}

.result-word-marquee {
  lines: 1;
  text-overflow: clip;
}

.result-tag {
  flex-shrink: 0;
  height: 28px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
  margin-left: 8px;
}

.result-phonetic {
  width: 100%;
  height: 22px;
  color: #aeb0b4;
  font-size: 16px;
}

.translation-box {
  width: 100%;
  flex-direction: column;
}

.result-translation-line {
  width: 100%;
  height: 22px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
}
</style>
