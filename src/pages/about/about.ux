  width: 78px;
  height: 54px;
  margin-bottom: 12px;
  border-radius: 22px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.back-mark {
  width: 64px;
  height: 30px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.about-list {
  width: 196px;
  height: 410px;
}

.list-item {
  width: 196px;
  flex-direction: column;
  align-items: center;
}

.section-inner {
  width: 196px;
  flex-direction: column;
  align-items: center;
}

.app-card {
  width: 188px;
  height: 240px;
  padding-left: 18px;
  padding-top: 24px;
  border-radius: 30px;
  background-color: #242424;
  flex-direction: column;
  position: relative;
}

.app-name {
  width: 138px;
  height: 44px;
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
  text-align: left;
}

.app-version {
  width: 80px;
  height: 38px;
  color: #aeb0b4;
  font-size: 28px;
  text-align: left;
}

.deco-icon-about {
  width: 116px;
  height: 116px;
  position: absolute;
  right: 6px;
  bottom: 6px;
}

.section-title {
  width: 180px;
  height: 38px;
  margin-top: 14px;
  color: #aeb0b4;
  font-size: 26px;
  font-weight: 700;
  text-align: left;
}

.dev-role {
  width: 180px;
  height: 24px;
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
  text-align: center;
}

.dev-name {
  width: 180px;
  height: 28px;
  color: #ffffff;
  font-size: 18px;
  text-align: center;
}

.license-line {
  width: 180px;
  height: 22px;
  color: #ffffff;
  font-size: 18px;
  text-align: center;
}

.desc-line {
  width: 180px;
  height: auto;
  margin-top: 6px;
  color: #ffffff;
  font-size: 18px;
  text-align: left;
}
</style>
