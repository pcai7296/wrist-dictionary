<template>
  <div class="page">
    <text class="title">腕上词典</text>

    <div class="icon-card">
      <img class="deco-icon" src="/common/deco-icon.png" />
    </div>

    <div class="button-group">
      <div class="main-button secondary-button" @click="goInflectSearch">
        <img class="btn-icon" src="/common/icons/btn_transform.png" />
        <text class="btn-label">查找变形</text>
      </div>
      <div class="main-button secondary-button" @click="goSearch">
        <img class="btn-icon" src="/common/icons/btn_search.png" />
        <text class="btn-label">中英查找</text>
