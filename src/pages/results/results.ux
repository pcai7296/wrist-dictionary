<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="back-button" @click="goBack">
      <text class="back-text">返回</text>
    </div>

    <text class="query-text">{{ queryText }}</text>
    <text class="status-text" if="{{ statusText }}">{{ statusText }}</text>

    <list class="result-list" if="{{ resultCards.length > 0 }}">
      <list-item
        class="result-item"
        type="resultCard"
        for="{{ item in resultCards }}"
        tid="id"
        style="height: {{ item.itemHeight }}px;"
      >
        <div class="result-card" style="height: {{ item.cardHeight }}px;" @click="openDetail(item)">
          <div class="result-head">
            <text class="result-word">{{ item.word }}</text>
            <text class="result-tag">{{ item.tag }}</text>
          </div>
          <text class="result-phonetic">{{ item.phonetic }}</text>
          <div class="translation-box">
            <text class="result-translation-line" for="{{ line in item.translationLines }}">{{ line }}</text>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"

export default {
  protected: {
    query: ""
  },

  private: {
    queryText: "",
    statusText: "",
    resultCards: [],
    searchToken: 0,
    shardIndex: null,
    fileCache: {},
    entryCache: {},
    touchStartX: -1,
    touchStartY: -1
  },

  onInit() {
    this.queryText = this.normalizeWord(this.query)
    this.performSearch()
  },

  goBack() {
    router.back()
  },

  openDetail(item) {
    if (!item || !item.word) {
      return
    }

    router.push({
      uri: "/pages/detail",
      params: {
      word: item.word,
      phonetic: item.rawPhonetic || "",
      translation: item.translation || "",
      tag: item.tag || ""
      }
    })
  },

  performSearch() {
    const normalized = this.normalizeWord(this.queryText)
    this.queryText = normalized

    if (!normalized) {
      this.resultCards = []
      this.statusText = ""
      return
    }

    const token = this.searchToken + 1
    this.searchToken = token
    this.resultCards = []
    this.statusText = "搜索中"

    if (this.hasChinese(normalized)) {
      this.performChineseSearch(normalized, token)
      return
    }

    this.loadShardIndex(() => {
      if (token !== this.searchToken) {
        return
      }

      const results = []
      const seen = {}
      const shards = this.getCandidateShards(normalized)

      this.collectShardResults(shards, normalized, results, seen, 0, () => {
        this.collectInflectResult(normalized, results, seen, () => {
          if (token !== this.searchToken) {
            return
          }

          this.resultCards = results.slice(0, 20)
          if (this.resultCards.length === 0) {
            this.statusText = "未找到"
          } else if (results.length >= 20) {
            this.statusText = "最多显示20条"
          } else {
            this.statusText = ""
          }
        })
      })
    })
  },

  performChineseSearch(query, token) {
    const normalizedQuery = this.normalizeChineseText(query)
    if (!normalizedQuery) {
      this.resultCards = []
      this.statusText = ""
      return
    }

    this.loadChineseIds(normalizedQuery, (ids) => {
      if (token !== this.searchToken) {
        return
      }

      const results = []
      const seen = {}
      this.collectChineseResults(ids, normalizedQuery, results, seen, 0, () => {
        if (token !== this.searchToken) {
          return
        }

        this.resultCards = results.slice(0, 20)
        if (this.resultCards.length === 0) {
          this.statusText = "未找到"
        } else if (results.length >= 20) {
          this.statusText = "最多显示20条"
        } else {
          this.statusText = ""
        }
      })
    })
  },

  loadChineseIds(query, done) {
    const firstChar = this.getFirstChineseChar(query)
    if (!firstChar) {
      done([])
      return
    }

    const bucket = this.zhBucketFor(firstChar)
    this.readText("/common/dict/zh_index/zh_" + bucket + ".txt", (text) => {
      const lines = text.split("\n")
      for (let i = 0; i < lines.length; i++) {
        const parts = lines[i].split("\t")
        if (parts.length >= 2 && parts[0] === firstChar) {
          done(parts[1].split(","))
          return
        }
      }
      done([])
    })
  },

  collectChineseResults(ids, query, results, seen, index, done) {
    if (index >= ids.length || results.length >= 20) {
      done()
      return
    }

    const entryId = this.parseEntryId(ids[index])
    if (entryId < 0) {
      this.collectChineseResults(ids, query, results, seen, index + 1, done)
      return
    }

    const shard = this.entryShardFor(entryId)
    this.loadEntryShard(shard, (entries) => {
      let nextIndex = index
      while (nextIndex < ids.length && results.length < 20) {
        const nextId = this.parseEntryId(ids[nextIndex])
        if (nextId < 0 || this.entryShardFor(nextId) !== shard) {
          break
        }

        const item = entries[nextId]
        if (item) {
          const lower = this.normalizeWord(item.word)
          if (!seen[lower] && this.normalizeChineseText(item.translation).indexOf(query) >= 0) {
            seen[lower] = true
            results.push(this.createResultCard(lower, item.word, item.phonetic, item.translation, item.tag))
          }
        }
        nextIndex++
      }

      this.collectChineseResults(ids, query, results, seen, nextIndex, done)
    })
  },

  loadEntryShard(shard, done) {
    if (this.entryCache[shard]) {
      done(this.entryCache[shard])
      return
    }

    this.readText("/common/dict/entries/entry_" + shard + ".txt", (text) => {
      const entries = {}
      const lines = text.split("\n")
      for (let i = 0; i < lines.length; i++) {
        const parts = lines[i].split("\t")
        if (parts.length >= 4) {
          entries[parts[0]] = {
            word: parts[1],
            phonetic: parts[2],
            translation: parts[3],
            tag: parts[4] || ""
          }
        }
      }
      this.entryCache[shard] = entries
      done(entries)
    })
  },

  loadShardIndex(done) {
    if (this.shardIndex) {
      done()
      return
    }

    this.readText("/common/dict/index_en.txt", (text) => {
      const index = {}
      const lines = text.split("\n")
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim()
        if (!line) {
          continue
        }
        const parts = line.split("\t")
        if (parts.length >= 2) {
          index[parts[0]] = parts[1].split(",")
        }
      }
      this.shardIndex = index
      done()
    })
  },

  getCandidateShards(query) {
    if (query.length === 1 && this.shardIndex && this.shardIndex[query]) {
      return this.shardIndex[query]
    }
    return [this.keyFor(query)]
  },

  collectShardResults(shards, query, results, seen, index, done) {
    if (index >= shards.length || results.length >= 20) {
      done()
      return
    }

    const shard = shards[index]
    this.readText("/common/dict/words/dict_" + shard + ".txt", (text) => {
      this.scanWordText(text, query, results, seen, "")
      this.collectShardResults(shards, query, results, seen, index + 1, done)
    })
  },

  collectInflectResult(query, results, seen, done) {
    if (results.length >= 20 || query.length < 2) {
      done()
      return
    }

    const shard = this.keyFor(query)
    this.readText("/common/dict/inflect/inflect_" + shard + ".txt", (text) => {
      const bases = []
      const lines = text.split("\n")
      for (let i = 0; i < lines.length; i++) {
        const parts = lines[i].split("\t")
        if (parts.length >= 2 && parts[0] === query) {
          const words = parts[1].split(",")
          for (let j = 0; j < words.length; j++) {
            if (words[j]) {
              bases.push(words[j])
            }
          }
          break
        }
      }
      this.collectBaseResults(bases, results, seen, 0, done)
    })
  },

  collectBaseResults(bases, results, seen, index, done) {
    if (index >= bases.length || results.length >= 20) {
      done()
      return
    }

    const base = bases[index]
    const shard = this.keyFor(base)
    this.readText("/common/dict/words/dict_" + shard + ".txt", (text) => {
      this.scanWordText(text, this.normalizeWord(base), results, seen, "变形")
      this.collectBaseResults(bases, results, seen, index + 1, done)
    })
  },

  scanWordText(text, query, results, seen, source) {
    if (!text) {
      return
    }
    const lines = text.split("\n")
    for (let i = 0; i < lines.length && results.length < 20; i++) {
      const parts = lines[i].split("\t")
      if (parts.length < 3) {
        continue
      }

      const word = parts[0]
      const lower = this.normalizeWord(word)
      if (!lower || seen[lower]) {
        continue
      }
      if (source) {
        if (lower !== query) {
          continue
        }
      } else if (lower.indexOf(query) !== 0) {
        continue
      }

      seen[lower] = true
      results.push(this.createResultCard(lower, word, parts[1], parts[2], source || parts[3] || ""))
    }
  },

  createResultCard(id, word, phonetic, translation, tag) {
    const lines = this.wrapText(translation || "", 168)
    const safeLines = lines.length > 0 ? lines : [""]
    const lineHeight = 22
    const cardHeight = Math.max(100, 64 + safeLines.length * lineHeight)

    return {
      id: id,
      word: word,
      phonetic: phonetic ? "/" + phonetic + "/" : "",
      rawPhonetic: phonetic || "",
      translation: translation || "",
      translationLines: safeLines,
      tag: tag,
      cardHeight: cardHeight,
      itemHeight: cardHeight + 10
    }
  },

  wrapText(value, maxWidth) {
    const text = (value || "").replace(/\s+/g, " ").trim()
    if (!text) {
      return []
    }

    const lines = []
    let line = ""
    let width = 0
    let lastBreak = -1

    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      const chWidth = this.getCharWidth(ch)

      if (width + chWidth > maxWidth && line.length > 0) {
        if (lastBreak > 0) {
          lines.push(line.slice(0, lastBreak).trim())
          line = line.slice(lastBreak).trim() + ch
        } else {
          lines.push(line.trim())
          line = ch
        }
        width = this.measureTextWidth(line)
        lastBreak = this.findLastBreak(line)
      } else {
        line += ch
        width += chWidth
      }

      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        lastBreak = line.length
      }
    }

    if (line.trim()) {
      lines.push(line.trim())
    }
    return lines
  },

  measureTextWidth(value) {
    let width = 0
    for (let i = 0; i < value.length; i++) {
      width += this.getCharWidth(value.charAt(i))
    }
    return width
  },

  findLastBreak(value) {
    for (let i = value.length - 1; i >= 0; i--) {
      const ch = value.charAt(i)
      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        return i + 1
      }
    }
    return -1
  },

  getCharWidth(ch) {
    if (!ch) {
      return 0
    }
    if (ch >= "\u4e00" && ch <= "\u9fff") {
      return 13
    }
    if (ch >= "A" && ch <= "Z") {
      return 8
    }
    if (ch >= "a" && ch <= "z") {
      return 7
    }
    if (ch >= "0" && ch <= "9") {
      return 7
    }
    if (ch === " " || ch === "." || ch === "," || ch === ";" || ch === ":" || ch === "/" || ch === "-") {
      return 4
    }
    return 8
  },

  readText(uri, done) {
    if (this.fileCache[uri]) {
      done(this.fileCache[uri])
      return
    }

    file.readText({
      uri: uri,
      encoding: "utf-8",
      success: (data) => {
        const text = data && data.text ? data.text : ""
        this.fileCache[uri] = text
        done(text)
      },
      fail: () => {
        this.fileCache[uri] = ""
        done("")
      }
    })
  },

  normalizeWord(value) {
    return (value || "").toLowerCase().trim()
  },

  hasChinese(value) {
    const text = value || ""
    for (let i = 0; i < text.length; i++) {
      if (this.isChineseChar(text.charAt(i))) {
        return true
      }
    }
    return false
  },

  normalizeChineseText(value) {
    const text = value || ""
    let output = ""
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      if (this.isChineseChar(ch)) {
        output += ch
      }
    }
    return output
  },

  getFirstChineseChar(value) {
    const text = value || ""
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      if (this.isChineseChar(ch)) {
        return ch
      }
    }
    return ""
  },

  isChineseChar(ch) {
    return ch >= "\u4e00" && ch <= "\u9fff"
  },

  zhBucketFor(ch) {
    return this.padHex(ch.charCodeAt(0) % 64)
  },

  padHex(value) {
    const hex = value.toString(16)
    if (hex.length < 2) {
      return "0" + hex
    }
    return hex
  },

  parseEntryId(value) {
    const id = parseInt(value)
    if (isNaN(id)) {
      return -1
    }
    return id
  },

  entryShardFor(entryId) {
    const index = Math.floor(entryId / 500)
    if (index < 10) {
      return "0" + index
    }
    return "" + index
  },

  keyFor(value) {
    const word = this.normalizeWord(value)
    let key = ""
    for (let i = 0; i < word.length && key.length < 2; i++) {
      const ch = word.charAt(i)
      if ((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")) {
        key += ch
      } else {
        key += "_"
      }
    }
    while (key.length < 2) {
      key += "_"
    }
    return key
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const startsInLeftQuarter = this.touchStartX <= 53
    const endsAtRightQuarter = endX >= 159
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 520px;
  padding-top: 24px;
  background-color: #020813;
  flex-direction: column;
  align-items: center;
}

.back-button {
  width: 78px;
  height: 54px;
  border-radius: 22px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.back-text {
  width: 70px;
  height: 30px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.query-text {
  width: 168px;
  height: 36px;
  margin-top: 12px;
  margin-bottom: 6px;
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
  text-align: center;
}

.status-text {
  width: 168px;
  height: 20px;
  margin-bottom: 4px;
  color: #7eaef8;
  font-size: 14px;
  text-align: center;
}

.result-list {
  width: 190px;
  height: 388px;
  margin-bottom: 4px;
}

.result-item {
  width: 190px;
}

.result-card {
  width: 190px;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 12px;
  margin-bottom: 10px;
  border-radius: 20px;
  background-color: #242424;
  flex-direction: column;
}

.result-head {
  width: 166px;
  height: 38px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.result-word {
  width: 112px;
  height: 38px;
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
}

.result-tag {
  width: 50px;
  height: 28px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
  text-align: right;
}

.result-phonetic {
  width: 166px;
  height: 22px;
  color: #aeb0b4;
  font-size: 16px;
}

.translation-box {
  width: 166px;
  flex-direction: column;
}

.result-translation-line {
  width: 166px;
  height: 22px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
}
</style>
