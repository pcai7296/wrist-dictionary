<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="back-button" @click="goBack">
      <text class="back-text">返回</text>
    </div>

    <div class="word-area" style="margin-left: {{wordAreaMarginLeft}}px;">
      <marquee if="{{ wordMarqueeOn }}" class="word-marquee" style="width: {{contentWidth}}px;"
        scrollamount="{{ wordMarqueeSpeed }}" direction="left" loop="-1" text-offset="40">
        {{ wordText }}   {{ wordText }}
      </marquee>
      <text if="{{ !wordMarqueeOn }}" class="word-text" style="width: {{contentWidth}}px;">{{ wordText }}</text>
      <text class="phonetic-text" style="width: {{contentWidth}}px;">{{ phoneticText }}</text>
    </div>

    <div class="content-area">
      <list class="meaning-list" style="width: {{cardWidth}}px;">
        <list-item class="meaning-item" type="meaningLine" for="{{ item in displayLines }}">
          <text class="{{ item.isTag ? 'tag-line' : 'meaning-line' }}">{{ item.text }}</text>
        </list-item>
      </list>
    </div>

    <div class="bottom-row" style="{{ bottomStyle }}">
      <input class="bottom-button inflect-button" style="{{ inflectBtnStyle }}" type="button" value="查变形" @click="goInflect" />
      <input class="bottom-button favorite-button" style="{{ favoriteBtnStyle }}" type="button" value="{{ favoriteLabel }}" @click="toggleFavorite" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import file from "@system.file"
import prompt from "@system.prompt"
import {decodePrefixField, parseBase36} from "../../common/dictCodec"

var TAG_CODE_MAP = {z: 'zk', g: 'gk', '4': 'cet4', '6': 'cet6', k: 'ky', t: 'toefl', i: 'ielts', e: 'gre'}
var TAG_LABELS = ['zk', 'gk', 'cet4', 'cet6', 'ky', 'ielts', 'toefl', 'gre']

var IPA_DECODE_MAP = {
  'a': '\u0259', 'r': '\u025a', 'e': '\u025b',
  'i': '\u026a', "'": '\u02c8', ',': '\u02cc',
  'A': '\u0251', 'U': '\u028a', 'S': '\u0283',
  'Z': '\u0292', 'T': '\u03b8', 'D': '\u00f0',
  'N': '\u014b', 'O': '\u0254', 'E': '\u00e6',
  'R': '\u025c', '|': '\u02d0', 'Q': '\u0252',
  'V': '\u028c', 'g': '\u0261'
}

var PHRASE_DECODE_MAP = {
  '!': 'vt. ', '$': 'vi. ', '@': 'n. ', '#': 'a. ',
  '%': 'ad. ', '^': 'prep. ', '&': 'conj. ', '*': 'pron. ',
  '(': 'int. ', ')': 'num. ', '-': 'art. ', '=': 'aux. ',
  '{': '[计]', '}': '[法]', '|': '[医]', '[': '[生]',
  ']': '[化]', '<': '[物]', '>': '[经]'
}

export default {
  protected: {
    word: "",
    phonetic: "",
    translation: "",
    tag: "",
    searchMode: "",
    inflectDepth: ""
  },

  private: {
    wordText: "",
    phoneticText: "",
    translationText: "",
    tagText: "",
    tagLines: [],
    translationLines: [],
    cardWidth: 188,
    contentWidth: 164,
    favoriteLabel: "收藏",
    fileCache: {},
    sourceWord: "",
    inflectForms: [],
    lastToastAt: 0,
    toastCooldown: 1500,
    lastInflectAt: 0,
    inflectPressCooldown: 1000,
    maxInflectDepth: 3,
    touchStartX: -1,
    touchStartY: -1,
    destroyed: false,
    wordMarqueeOn: false,
    wordMarqueeSpeed: 40,
    wordMarqueeThreshold: 9,
    wordAreaMarginLeft: 15
  },

  _expandTag(s) {
    if (!s) return ''
    s = s.replace(/\r/g, '')
    if (s.indexOf(',') < 0 && /^[0-9a-f]+$/.test(s)) {
      var mask = parseInt(s, 16)
      var labels = []
      for (var bit = 0; bit < TAG_LABELS.length; bit++) {
        if (mask & (1 << bit)) {
          labels.push(TAG_LABELS[bit])
        }
      }
      return labels.join(' ')
    }
    return s.split(',').map(function(c) { return TAG_CODE_MAP[c] || c }).filter(Boolean).join(' ')
  },

  _decodeIpa(s) {
    if (!s) return s
    s = s.replace(/\r/g, '')
    var out = ''
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i)
      out += IPA_DECODE_MAP[ch] || ch
    }
    return out
  },

  _decodePhrase(s) {
    if (!s) return s
    s = s.replace(/\r/g, '')
    var out = ''
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i)
      out += PHRASE_DECODE_MAP[ch] || ch
    }
    return out
  },

  onInit() {
    const sw = this.$app.$def.data.screenWidth || 212
    this.cardWidth = sw - 20
    this.contentWidth = this.cardWidth - 24
    this.wordAreaMarginLeft = sw === 466 ? 45 : 15
    this.isRoundScreen = sw === 466
    this.isCapsule = sw === 192 || sw === 212
    if (this.isRoundScreen) {
      this.bottomStyle = "justify-content: center;"
      this.inflectBtnStyle = "margin-right: 5px;"
      this.favoriteBtnStyle = "margin-left: 5px;"
    } else if (this.isCapsule) {
      this.bottomStyle = "margin-bottom: 40px;"
      this.inflectBtnStyle = ""
      this.favoriteBtnStyle = ""
    } else {
      this.bottomStyle = ""
      this.inflectBtnStyle = ""
      this.favoriteBtnStyle = ""
    }
    this.wordText = this.word || ""
    this.phoneticText = this.phonetic ? "/" + (this.phonetic || "") + "/" : ""
    this.translationText = this._decodePhrase(this.translation || "")
    this.tagText = this._expandTag(this.tag || "")
    this.wordMarqueeThreshold = this.resolveWordMarqueeThreshold(sw)
    this.applyWordMarquee(this.wordText)
    const tagLines = this.tagText ? this.tagText.split(" ") : []
    const wrapW = this.contentWidth - 24
    this.translationLines = this.wrapText(this.translationText, wrapW)
    if (this.translationLines.length === 0) {
      this.translationLines = [""]
    }
    this.displayLines = []
    for (let i = 0; i < this.translationLines.length; i++) {
      this.displayLines.push({ text: this.translationLines[i], isTag: false })
    }
    for (let i = 0; i < tagLines.length; i++) {
      this.displayLines.push({ text: tagLines[i], isTag: true })
    }
    this.refreshFavoriteState()
  },

  onDestroy() {
    this.destroyed = true
  },

  goBack() {
    router.back()
  },

  resolveWordMarqueeThreshold(sw) {
    if (sw === 192) return 8
    if (sw === 212) return 9
    if (sw === 336) return 16
    if (sw === 432) return 20
    if (sw === 466) return 20
    return 9
  },

  applyWordMarquee(text) {
    if (text && text.length > this.wordMarqueeThreshold) {
      this.wordMarqueeOn = true
      const extra = text.length - this.wordMarqueeThreshold
      this.wordMarqueeSpeed = Math.max(40, Math.min(60, Math.round(40 + extra * 1.5)))
    } else {
      this.wordMarqueeOn = false
      this.wordMarqueeSpeed = 40
    }
  },

  goInflect() {
    if (!this.wordText) {
      return
    }

    const now = Date.now()
    if (now - this.lastInflectAt < this.inflectPressCooldown) {
      this.showToast("操作太快")
      return
    }
    this.lastInflectAt = now

    const depth = this.currentInflectDepth()
    if (depth >= this.maxInflectDepth) {
      this.showToast("最多查三层")
      return
    }

    router.replace({
      uri: "/pages/results",
      params: {
        query: this.wordText,
        searchMode: "inflect",
        inflectDepth: "" + (depth + 1)
      }
    })
  },

  goInflectParam(queryWord) {
    if (!queryWord) {
      return
    }
    router.push({
      uri: "/pages/results",
      params: {
        query: queryWord,
        searchMode: this.searchMode || "",
        inflectDepth: this.inflectDepth || "0"
      }
    })
  },

  currentInflectDepth() {
    const depth = parseInt(this.inflectDepth)
    if (isNaN(depth) || depth < 0) {
      return 0
    }
    return depth
  },

  showToast(message) {
    const now = Date.now()
    if (now - this.lastToastAt < this.toastCooldown) {
      return
    }
    this.lastToastAt = now
    prompt.showToast({
      message: message,
      duration: 1500
    })
  },

  toggleFavorite() {
    if (!this.wordText) {
      return
    }
    const item = this.currentItem()
    storage.get({
      key: "dic_favorites",
      success: (data) => {
        const list = this.parseList(data)
        this.writeFavoriteList(list, item)
      },
      fail: () => {
        this.writeFavoriteList([], item)
      }
    })
  },

  writeFavoriteList(list, item) {
    const word = this.normalizeWord(item.word)
    let existed = false
    const output = []

    for (let i = 0; i < list.length; i++) {
      const oldItem = list[i]
      if (oldItem && this.normalizeWord(oldItem.word) === word) {
        existed = true
      } else if (oldItem && output.length < 20) {
        output.push(oldItem)
      }
    }

    if (!existed) {
      output.unshift(item)
      while (output.length > 20) {
        output.pop()
      }
      this.favoriteLabel = "已收藏"
    } else {
      this.favoriteLabel = "收藏"
    }

    storage.set({
      key: "dic_favorites",
      value: JSON.stringify(output)
    })
  },

  refreshFavoriteState() {
    storage.get({
      key: "dic_favorites",
      success: (data) => {
        if (this.destroyed) return
        const list = this.parseList(data)
        const word = this.normalizeWord(this.wordText)
        this.favoriteLabel = "收藏"
        for (let i = 0; i < list.length; i++) {
          if (list[i] && this.normalizeWord(list[i].word) === word) {
            this.favoriteLabel = "已收藏"
            return
          }
        }
      },
      fail: () => {
        if (this.destroyed) return
        this.favoriteLabel = "收藏"
      }
    })
  },

  currentItem() {
    return {
      word: this.wordText,
      phonetic: this.phonetic || "",
      translation: this.translationText,
      tag: this.tagText
    }
  },

  parseList(data) {
    if (!data) {
      return []
    }
    const text = data.value ? data.value : data
    try {
      const list = JSON.parse(text)
      if (list && list.length) {
        return list
      }
    } catch (err) {
      console.log('[腕上词典] storage data parse failed:', err && err.message)
      return []
    }
    return []
  },

  wrapText(value, maxWidth) {
    const text = (value || "").replace(/\s+/g, " ").trim()
    if (!text) {
      return []
    }

    const lines = []
    let line = ""
    let width = 0
    let lastBreak = -1

    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      const chWidth = this.getCharWidth(ch)

      if (width + chWidth > maxWidth && line.length > 0) {
        if (lastBreak > 0) {
          lines.push(line.slice(0, lastBreak).trim())
          line = line.slice(lastBreak).trim() + ch
        } else {
          lines.push(line.trim())
          line = ch
        }
        width = this.measureTextWidth(line)
        lastBreak = this.findLastBreak(line)
      } else {
        line += ch
        width += chWidth
      }

      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        lastBreak = line.length
      }
    }

    if (line.trim()) {
      lines.push(line.trim())
    }
    return lines
  },

  measureTextWidth(value) {
    let width = 0
    for (let i = 0; i < value.length; i++) {
      width += this.getCharWidth(value.charAt(i))
    }
    return width
  },

  findLastBreak(value) {
    for (let i = value.length - 1; i >= 0; i--) {
      const ch = value.charAt(i)
      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        return i + 1
      }
    }
    return -1
  },

  getCharWidth(ch) {
    if (!ch) {
      return 0
    }
    if (ch >= "\u4e00" && ch <= "\u9fff") {
      return 20
    }
    if (ch >= "A" && ch <= "Z") {
      return 12
    }
    if (ch >= "a" && ch <= "z") {
      return 11
    }
    if (ch >= "0" && ch <= "9") {
      return 11
    }
    if (ch === " " || ch === "." || ch === "," || ch === ";" || ch === ":" || ch === "/" || ch === "-") {
      return 7
    }
    return 12
  },

  normalizeWord(value) {
    return (value || "").toLowerCase().trim()
  },

  entryShardFor(entryId) {
    const index = Math.floor(entryId / 500)
    return index < 10 ? "0" + index : "" + index
  },

  keyFor(value) {
    const word = this.normalizeWord(value)
    const first = word.charAt(0)
    return first >= "a" && first <= "z" ? first : "_"
  },

  readText(uri, done) {
    if (this.fileCache[uri]) {
      done(this.fileCache[uri])
      return
    }
    file.readText({
      uri: uri,
      encoding: "utf-8",
      success: (data) => {
        if (this.destroyed) return
        const text = data && data.text ? data.text : ""
        this.fileCache[uri] = text
        done(text)
      },
      fail: () => {
        if (this.destroyed) return
        this.fileCache[uri] = ""
        done("")
      }
    })
  },

  loadReverseInflectForms(base, currentWord, showSource) {
    const revShard = this.keyFor(base)
    this.readText("/common/dict/inflect_reverse/ireverse_" + revShard + ".txt", (revText) => {
      if (!revText) {
        return
      }
      const values = this.scanReverseInflect(revText, base)
      this.resolveReverseInflectValues(values, currentWord, [], 0, (allForms) => {
        if (allForms.length > 0) {
          if (showSource) {
            this.sourceWord = base
          }
          this.inflectForms = allForms.slice(0, 10)
        }
      })
    })
  },

  scanReverseInflect(text, base) {
    const lines = text.split("\n")
    const values = []
    let previous = ""
    for (let i = 0; i < lines.length; i++) {
      const parts = lines[i].split("\t")
      if (parts.length < 2) {
        continue
      }
      const word = decodePrefixField(parts[0], previous)
      if (word === null) {
        continue
      }
      previous = word
      if (word !== base) {
        continue
      }
      const encoded = parts[1].split(",")
      for (let j = 0; j < encoded.length; j++) {
        const value = encoded[j]
        if (!value) {
          continue
        }
        if (value.charAt(0) === "@") {
          const entryId = parseBase36(value.slice(1))
          if (entryId >= 0) {
            values.push(entryId)
          }
        } else {
          values.push(value)
        }
      }
      break
    }
    return values
  },

  resolveReverseInflectValues(values, currentWord, output, index, done) {
    if (index >= values.length || output.length >= 10) {
      done(output)
      return
    }
    const value = values[index]
    if (typeof value === "string") {
      if (value !== currentWord && output.indexOf(value) < 0) {
        output.push(value)
      }
      this.resolveReverseInflectValues(values, currentWord, output, index + 1, done)
      return
    }
    this.loadEntryWord(value, (word) => {
      if (word && word !== currentWord && output.indexOf(word) < 0) {
        output.push(word)
      }
      this.resolveReverseInflectValues(values, currentWord, output, index + 1, done)
    })
  },

  loadEntryWord(entryId, done) {
    const shard = this.entryShardFor(entryId)
    this.readText("/common/dict/entries/entry_" + shard + ".txt", (text) => {
      const lines = text.split("\n")
      let previous = ""
      const baseId = parseInt(shard, 10) * 500
      for (let i = 0; i < lines.length; i++) {
        const parts = lines[i].split("\t")
        if (parts.length < 3) {
          continue
        }
        const word = decodePrefixField(parts[0], previous)
        if (word === null) {
          continue
        }
        previous = word
        if (baseId + i === entryId) {
          done(word)
          return
        }
      }
      done("")
    })
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const sw = this.$app.$def.data.screenWidth || 212
    const startsInLeftQuarter = this.touchStartX <= sw * 0.25
    const endsAtRightQuarter = endX >= sw * 0.75
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 24px;
  background-color: #020813;
  flex-direction: column;
  align-items: center;
}

.back-button {
  width: 78px;
  height: 54px;
  border-radius: 22px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.back-text {
  width: 70px;
  height: 30px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.word-area {
  margin-top: 14px;
  flex-direction: column;
  align-items: flex-start;
}

.word-text,
.word-marquee {
  height: 40px;
  color: #ffffff;
  font-size: 32px;
  font-weight: 800;
  text-align: left;
}

.word-marquee {
  lines: 1;
  text-overflow: clip;
}

.phonetic-text {
  height: 36px;
  color: #a9c8f6;
  font-size: 28px;
  text-align: left;
}

.content-area {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.meaning-list {
  height: 286px;
  margin-top: 8px;
}

.meaning-item {
  height: 32px;
}

.meaning-line {
  height: 32px;
  margin-left: 10px;
  color: #e9f2ff;
  font-size: 27px;
  lines: 1;
  text-overflow: clip;
}

.tag-line {
  height: 34px;
  margin-left: 10px;
  color: #6ba3e8;
  font-size: 28px;
}

.bottom-row {
  height: 48px;
  margin-bottom: 10px;
  flex-direction: row;
  justify-content: space-between;
}

.bottom-button {
  width: 82px;
  height: 48px;
  border-radius: 18px;
  color: #ffffff;
  font-size: 18px;
  font-weight: 800;
  text-align: center;
}

.inflect-button {
  background-color: #0b65ea;
}

.favorite-button {
  background-color: #d82626;
}
</style>
