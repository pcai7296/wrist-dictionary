<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="back-button" @click="goBack">
      <text class="back-text">返回</text>
    </div>

    <list id="record-list" class="record-list" if="{{ recordItems.length > 0 }}" style="width: {{cardWidth}}px; height: {{listHeight}}px;">
      <list-item
        class="record-item"
        type="recordCard"
        for="{{ item in recordItems }}"
        tid="id"
        style="width: {{cardWidth}}px; height: {{ item.itemHeight }}px;"
      >
        <div if="{{ item.recordKind === 'clear-history' }}" class="clear-card" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="clearHistory">
          <text class="clear-text">清空历史记录</text>
        </div>
        <div elif="{{ item.recordKind === 'next-page' }}" class="next-button" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="_goToNextPage">
          <text class="next-text">下一页</text>
        </div>
        <div elif="{{ item.recordKind === 'prev-page' }}" class="next-button" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="_goToPrevPage">
          <text class="next-text">上一页</text>
        </div>
        <div else class="record-card" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="openRecord(item)">
          <div class="record-head">
            <text if="{{ !item.wordMarqueeOn }}" class="record-title">{{ item.title }}</text>
            <text if="{{ item.wordMarqueeOn && !marqueeArmed }}" class="record-title">{{ item.title }}</text>
            <marquee if="{{ item.wordMarqueeOn && marqueeArmed }}" class="record-title-marquee"
              scrollamount="{{ item.wordMarqueeSpeed }}" direction="left" loop="-1" text-offset="40">
              {{ item.title }}   {{ item.title }}
            </marquee>
            <text class="record-tag">{{ item.tag }}</text>
          </div>
          <div class="record-translation-box">
            <text class="record-translation-line" for="{{ line in item.translationLines }}">
              {{ line }}
            </text>
          </div>
        </div>
      </list-item>
    </list>

    <text class="empty-text" if="{{ recordItems.length == 0 }}">{{ emptyText }}</text>

    <!-- 弹性撑开 → 筛选按钮贴底 -->
    <div if="{{ type === 'favorites' }}" style="flex: 1;"></div>

    <!-- 筛选按钮（仅收藏页） -->
    <div if="{{ type === 'favorites' }}" class="filter-btn" @click="openFilterPage">
      <text if="{{ activeFilter === '全部' }}" class="filter-btn-text">筛选</text>
      <text if="{{ activeFilter !== '全部' }}" class="filter-btn-text">筛选 · {{ activeFilter }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  protected: {
    type: "",
    filterLetter: ""
  },

  private: {
    recordItems: [],
    emptyText: "",
    touchStartX: -1,
    touchStartY: -1,
    destroyed: false,
    cardWidth: 188,
    contentWidth: 164,
    screenWidth: 0,
    wordMarqueeThreshold: 10,
    marqueeArmed: false,
    activeFilter: "全部",
    listHeight: 388,
    allRecords: [],
    searchPage: 0,
    totalRecordCount: 0,
    marqueeTimer: null,
    pageScrollTimer: null
  },

  onInit() {
    const sw = this.$app.$def.data.screenWidth || 212
    this.screenWidth = sw
    if (sw === 466) {
      // 圆屏：卡片置于内切正方形内(安全区域)，避免圆角裁切
      this.cardWidth = Math.round(sw / Math.SQRT2) // 330
    } else {
      this.cardWidth = sw - 20
    }
    this.contentWidth = this.cardWidth - 24
    this.wordMarqueeThreshold = this.resolveWordMarqueeThreshold(sw)
    this.listHeight = this.type === "favorites" ? 370 : 388
    if (this.type === "favorites" && this.filterLetter) {
      this.activeFilter = this.filterLetter
    }
    this.loadRecords()
  },

  openFilterPage() {
    router.replace({
      uri: "/pages/filter",
      params: {
        currentFilter: this.activeFilter
      }
    })
  },

  onDestroy() {
    this.destroyed = true
    if (this.marqueeTimer) {
      clearTimeout(this.marqueeTimer)
      this.marqueeTimer = null
    }
    if (this.pageScrollTimer) {
      clearTimeout(this.pageScrollTimer)
      this.pageScrollTimer = null
    }
  },

  onShow() {
    this.loadRecords()
    // 1.5s 让人先看清单词，再齐步启动所有跑马灯
    if (this.marqueeTimer) {
      clearTimeout(this.marqueeTimer)
    }
    this.marqueeTimer = setTimeout(() => {
      this.marqueeTimer = null
      if (!this.destroyed) {
        this.marqueeArmed = true
      }
    }, 1500)
  },

  goBack() {
    router.back()
  },

  resolveWordMarqueeThreshold(sw) {
    if (sw === 192) return 9
    if (sw === 212) return 10
    if (sw === 336) return 20
    if (sw === 432) return 25
    if (sw === 466) return 25
    return 10
  },

  calcCardWordMarqueeSpeed(word) {
    // 速度 ≈ 词长 × 4，让长词追上视觉上的同步循环。除非 word 太长会失控，用 60 封顶。
    const len = (word || "").length
    return Math.min(60, Math.max(40, len * 4))
  },

  canFitWithTag(word, tag) {
    if (!tag) return true
    const WORD_FONT = 28
    const TAG_FONT = 18
    const TAG_MARGIN = 8
    const CARD_PADDING = 24
    const WORD_GLYPH_RATIO = 0.72
    const TAG_GLYPH_RATIO = 0.6
    const SAFETY = 4
    const safeLen = (word || "").length
    if (safeLen === 0) return true
    const wordW = safeLen * WORD_FONT * WORD_GLYPH_RATIO
    const tagW = tag.length * TAG_FONT * TAG_GLYPH_RATIO + TAG_MARGIN + SAFETY
    return wordW + tagW <= this.cardWidth - CARD_PADDING
  },

  highestTag(tag) {
    if (!tag) return ""
    const tags = tag.split(" ")
    const priority = ["zk", "gk", "cet4", "cet6", "ky", "ielts", "toefl", "gre"]
    let best = tags[0] || ""
    let bestIdx = -1
    for (let i = 0; i < tags.length; i++) {
      const idx = priority.indexOf(tags[i])
      if (idx > bestIdx) {
        bestIdx = idx
        best = tags[i]
      }
    }
    return best
  },

  loadRecords() {
    const key = this.getStorageKey()
    this.emptyText = this.type === "favorites" ? "暂无收藏" : "暂无历史"
    storage.get({
      key: key,
      success: (data) => {
        if (this.destroyed) return
        let list = this.parseList(data)
        if (this.type === "favorites") {
          if (this.activeFilter !== "全部") {
            // 按首字母筛选
            const letter = this.activeFilter.toLowerCase()
            list = list.filter((item) => {
              return (item.word || "").toLowerCase().charAt(0) === letter
            })
            // 筛选后按字母排序 A→Z
            list.sort((a, b) => {
              const wa = (a.word || "").toLowerCase()
              const wb = (b.word || "").toLowerCase()
              if (wa < wb) return -1
              if (wa > wb) return 1
              return 0
            })
          }
          // 未筛选时保持自然顺序（最新添加的在最前）
          // 更新空文本
          if (list.length === 0 && this.activeFilter !== "全部") {
            this.emptyText = '"' + this.activeFilter + '" 暂无收藏'
          }
        }
        this.allRecords = this.buildRecords(list)
        this.totalRecordCount = this.allRecords.length
        this.searchPage = 0
        this._buildPageView()
      },
      fail: () => {
        if (this.destroyed) return
        this.allRecords = []
        this.totalRecordCount = 0
        this.searchPage = 0
        this.recordItems = []
      }
    })
  },

  _buildPageView() {
    var pageSize = 20
    var start = this.searchPage * pageSize
    var end = Math.min(start + pageSize, this.totalRecordCount)
    var pageCards = []

    // 上一页按钮
    if (this.searchPage > 0) {
      pageCards.push({
        id: "prev_page",
        recordKind: "prev-page",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordMarqueeSpeed: 40
      })
    }

    // 本页卡片
    for (var i = start; i < end; i++) {
      pageCards.push(this.allRecords[i])
    }

    // 下一页按钮
    if (end < this.totalRecordCount) {
      pageCards.push({
        id: "next_page",
        recordKind: "next-page",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordMarqueeSpeed: 40
      })
    }

    // 历史记录清空按钮（仅最后一页）
    if (this.type === "history" && end >= this.totalRecordCount && this.totalRecordCount > 0) {
      pageCards.push({
        id: "clear_history",
        recordKind: "clear-history",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordMarqueeSpeed: 40
      })
    }

    this.recordItems = pageCards
  },

  _goToNextPage() {
    this.searchPage++
    this._buildPageView()
    var self = this
    if (this.pageScrollTimer) {
      clearTimeout(this.pageScrollTimer)
    }
    this.pageScrollTimer = setTimeout(function() {
      self.pageScrollTimer = null
      if (self.destroyed) return
      var list = self.$element("record-list")
      if (list && list.scrollTo) {
        list.scrollTo({index: 0})
      }
    }, 100)
  },

  _goToPrevPage() {
    this.searchPage--
    this._buildPageView()
    var self = this
    if (this.pageScrollTimer) {
      clearTimeout(this.pageScrollTimer)
    }
    this.pageScrollTimer = setTimeout(function() {
      self.pageScrollTimer = null
      if (self.destroyed) return
      var list = self.$element("record-list")
      if (list && list.scrollTo) {
        list.scrollTo({index: self.recordItems.length - 1})
      }
    }, 300)
  },

  openRecord(item) {
    if (!item) {
      return
    }
    if (this.type === "history") {
      router.push({
        uri: "/pages/results",
        params: {
          query: item.query || item.word || "",
          searchMode: "",
          inflectDepth: "0"
        }
      })
      return
    }
    if (!item.word) {
      return
    }
    router.push({
      uri: "/pages/detail",
      params: {
        word: item.word,
        phonetic: item.rawPhonetic || "",
        translation: item.translation || "",
        tag: item.rawTag || "",
        searchMode: "",
        inflectDepth: "0"
      }
    })
  },

  getStorageKey() {
    if (this.type === "favorites") {
      return "dic_favorites"
    }
    return "dic_history"
  },

  buildRecords(list) {
    const output = []
    for (let i = 0; i < list.length; i++) {
      const item = list[i]
      if (!item) {
        continue
      }
      if (this.type === "history") {
        const query = (item.query || "").toString()
        if (!query) {
          continue
        }
        const displayTitle = query
        const visibleTag = ""
        const cardHeight = Math.max(80, 64)
        const titleLen = displayTitle.length
        const wordMarqueeOn = titleLen > this.wordMarqueeThreshold
        const wordMarqueeSpeed = wordMarqueeOn ? this.calcCardWordMarqueeSpeed(displayTitle) : 40
        output.push({
          id: this.normalizeWord(query) + "_" + i,
          title: displayTitle,
          query: query,
          recordKind: "history",
          translationLines: [""],
          rawTag: "",
          tag: visibleTag,
          cardHeight: cardHeight,
          itemHeight: cardHeight + 10,
          wordMarqueeOn: wordMarqueeOn,
          wordMarqueeSpeed: wordMarqueeSpeed
        })
        continue
      }
      const word = (item.word || "").toString()
      if (!word) {
        continue
      }
      const phonetic = item.phonetic || ""
      const translation = item.translation || ""
      const bestTag = this.highestTag(item.tag || "")
      const visibleTag = this.canFitWithTag(word, bestTag) ? bestTag : ""
      const lines = this.wrapText(translation, this.contentWidth)
      const safeLines = lines.length > 0 ? lines : [""]
      const lineHeight = 22
      const cardHeight = Math.max(100, 64 + safeLines.length * lineHeight)
      const titleLen = word.length
      const wordMarqueeOn = titleLen > this.wordMarqueeThreshold
      const wordMarqueeSpeed = wordMarqueeOn ? this.calcCardWordMarqueeSpeed(word) : 40
      output.push({
        id: this.normalizeWord(word) + "_" + i,
        title: word,
        word: word,
        phonetic: phonetic,
        rawPhonetic: phonetic,
        translation: translation,
        translationLines: safeLines,
        recordKind: "favorites",
        tag: visibleTag,
        rawTag: bestTag,
        cardHeight: cardHeight,
        itemHeight: cardHeight + 10,
        wordMarqueeOn: wordMarqueeOn,
        wordMarqueeSpeed: wordMarqueeSpeed
      })
    }
    return output
  },

  clearHistory() {
    storage.set({
      key: "dic_history",
      value: "[]"
    })
    router.replace({
      uri: "/pages/index"
    })
  },

  wrapText(value, maxWidth) {
    const text = (value || "").replace(/\s+/g, " ").trim()
    if (!text || maxWidth <= 0) {
      return []
    }

    const lines = []
    let line = ""
    let width = 0
    let lastBreak = -1

    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      const chWidth = this.getCharWidth(ch)

      if (width + chWidth > maxWidth && line.length > 0) {
        if (lastBreak > 0) {
          lines.push(line.slice(0, lastBreak).trim())
          line = line.slice(lastBreak).trim() + ch
        } else {
          lines.push(line.trim())
          line = ch
        }
        width = this.measureTextWidth(line)
        lastBreak = this.findLastBreak(line)
      } else {
        line += ch
        width += chWidth
      }

      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        lastBreak = line.length
      }
    }

    if (line.trim()) {
      lines.push(line.trim())
    }
    return lines
  },

  measureTextWidth(value) {
    let width = 0
    for (let i = 0; i < value.length; i++) {
      width += this.getCharWidth(value.charAt(i))
    }
    return width
  },

  findLastBreak(value) {
    for (let i = value.length - 1; i >= 0; i--) {
      const ch = value.charAt(i)
      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        return i + 1
      }
    }
    return -1
  },

  getCharWidth(ch) {
    if (!ch) {
      return 0
    }
    if (ch >= "\u4e00" && ch <= "\u9fff") {
      return 13
    }
    if (ch >= "A" && ch <= "Z") {
      return 8
    }
    if (ch >= "a" && ch <= "z") {
      return 7
    }
    if (ch >= "0" && ch <= "9") {
      return 7
    }
    if (
      ch === " " ||
      ch === "." ||
      ch === "," ||
      ch === ";" ||
      ch === ":" ||
      ch === "/" ||
      ch === "-"
    ) {
      return 4
    }
    return 8
  },

  parseList(data) {
    if (!data) {
      return []
    }
    const text = data.value ? data.value : data
    try {
      const list = JSON.parse(text)
      if (list && list.length) {
        return list
      }
    } catch (err) {
      console.log("[腕上词典] storage data parse failed:", err && err.message)
      return []
    }
    return []
  },

  normalizeWord(value) {
    return (value || "").toLowerCase().trim()
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const sw = this.$app.$def.data.screenWidth || 212
    const startsInLeftQuarter = this.touchStartX <= sw * 0.25
    const endsAtRightQuarter = endX >= sw * 0.75
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 8px;
  background-color: #020813;
  flex-direction: column;
  align-items: center;
}

.back-button {
  width: 78px;
  height: 54px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.back-text {
  width: 70px;
  height: 30px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.record-list {
  margin-bottom: 4px;
}

.record-item {
  /* width bound inline */
}

.record-card {
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 12px;
  margin-bottom: 10px;
  border-radius: 20px;
  background-color: #242424;
  flex-direction: column;
}

.clear-card {
  margin-bottom: 10px;
  border-radius: 20px;
  background-color: #8b0000;
  justify-content: center;
  align-items: center;
}

.clear-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.next-button {
  height: 56px;
  border-radius: 20px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.next-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.record-head {
  width: 100%;
  height: 38px;
  flex-direction: row;
  align-items: center;
}

.record-title,
.record-title-marquee {
  flex: 1;
  height: 38px;
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
}

.record-title-marquee {
  lines: 1;
  text-overflow: clip;
}

.record-tag {
  flex-shrink: 0;
  height: 28px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
  margin-left: 8px;
}

.record-translation-box {
  width: 100%;
  flex-direction: column;
}

.record-translation-line {
  width: 100%;
  height: 22px;
  color: #aeb0b4;
  font-size: 18px;
  font-weight: 700;
}

.empty-text {
  width: 168px;
  height: 40px;
  margin-top: 120px;
  color: #aeb0b4;
  font-size: 22px;
  text-align: center;
}

.filter-btn {
  width: 100px;
  height: 38px;
  margin-bottom: 30px;
  border-radius: 22px;
  background-color: #0b65ea;
  justify-content: center;
  align-items: center;
}

.filter-btn-text {
  width: 90px;
  height: 28px;
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
  text-align: center;
}
</style>
